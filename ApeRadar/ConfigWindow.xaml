                            <Grid Grid.Row="2" Grid.Column="3">
                                <ComboBox x:Name="ComboBoxAPIType" DisplayMemberPath="Content" SelectedValuePath="Value" Width="280" Margin="5" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <model:ListItem Content="{DynamicResource ComboBoxItemAPITypeVortex}" Value="VORTEX"/>
                                        <model:ListItem Content="{DynamicResource ComboBoxItemAPITypeWGPublic}" Value="WG_PUBLIC"/>
                                        <model:ListItem Content="{DynamicResource ComboBoxItemAPITypeWGPublicWithYuyukoProxy}" Value="WG_PUBLIC_WITH_YUYUKO_PROXY"/>
                                    </ComboBox>
                            </Grid>
                            <Grid Grid.Row="3" Grid.Column="3">
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox x:Name="ChkBoxEnableYuyukoAPIPush" Content="{DynamicResource ChkBoxEnableYuyukoAPIPush}" VerticalAlignment="Center" Margin="5"/>
                                    <Label Content="(?)" Margin="0,3,5,5" ToolTip="{DynamicResource ToolTipEnableYuyukoAPIPush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                            <Grid Grid.Row="4" Grid.Column="3">
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox x:Name="ChkBoxEnableDebugMode" Content="{DynamicResource ChkBoxEnableDebugMode}" VerticalAlignment="Center" Margin="5"/>
                                    <Label Content="(?)" Margin="0,3,5,5" ToolTip="{DynamicResource ToolTipDebugMode}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
            <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <Button x:Name="BtnSave" Style="{StaticResource ConfigPrimaryButtonStyle}" Content="{DynamicResource BtnSave}" Click="BtnSave_Click"/>
                    <Button x:Name="BtnCancel" Style="{StaticResource ConfigFooterButtonStyle}" Content="{DynamicResource BtnCancel}" Click="BtnCancel_Click"/>
                    <Button x:Name="BtnDefault" Style="{StaticResource ConfigFooterButtonStyle}" Content="{DynamicResource BtnDefault}" Click="BtnDefault_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</Window>
