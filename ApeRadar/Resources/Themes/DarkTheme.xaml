<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="AppBackgroundColor">#FF202020</Color>
    <Color x:Key="AppSurfaceColor">#FF2B2B2B</Color>
    <Color x:Key="AppSurfaceElevatedColor">#FF323232</Color>
    <Color x:Key="AppSurfaceAltColor">#FF303030</Color>
    <Color x:Key="AppInputBackgroundColor">#FF1F1F1F</Color>
    <Color x:Key="AppForegroundColor">#FFFFFFFF</Color>
    <Color x:Key="AppMutedForegroundColor">#FFCFCFCF</Color>
    <Color x:Key="AppFadedForegroundColor">#99FFFFFF</Color>
    <Color x:Key="AppDisabledForegroundColor">#FF8F8F8F</Color>
    <Color x:Key="AppBorderColor">#FF4A4A4A</Color>
    <Color x:Key="AppGridLineColor">#FF3A3A3A</Color>
    <Color x:Key="AppSelectionColor">#FF164A72</Color>
    <Color x:Key="AppSelectionInactiveColor">#FF373737</Color>
    <Color x:Key="AppAccentColor">#FF60CDFF</Color>
    <Color x:Key="AppAccentHoverColor">#FF8ADBF9</Color>
    <Color x:Key="AppAccentPressedColor">#FF4CC2F1</Color>
    <Color x:Key="AppHyperlinkColor">#FF60CDFF</Color>
    <Color x:Key="AppSuccessColor">#FF6CCB5F</Color>
    <Color x:Key="AppWarningColor">#FFFCE100</Color>
    <Color x:Key="AppDangerColor">#FFFF99A4</Color>
    <Color x:Key="AppInfoColor">#FF60CDFF</Color>
    <Color x:Key="AppChartTextColor">#FFFFFFFF</Color>
    <Color x:Key="AppChartSeparatorColor">#FF3A3A3A</Color>
    <Color x:Key="AppChartCrosshairColor">#FF9D9D9D</Color>
    <Color x:Key="AppChartSectionEvenColor">#FF282828</Color>
    <Color x:Key="AppChartSectionOddColor">#FF202020</Color>
    <Color x:Key="AppTagUnavailableBackgroundColor">#FF4A4A4A</Color>

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}"/>
    <SolidColorBrush x:Key="AppSurfaceBrush" Color="{StaticResource AppSurfaceColor}"/>
    <SolidColorBrush x:Key="AppSurfaceElevatedBrush" Color="{StaticResource AppSurfaceElevatedColor}"/>
    <SolidColorBrush x:Key="AppSurfaceAltBrush" Color="{StaticResource AppSurfaceAltColor}"/>
    <SolidColorBrush x:Key="AppInputBackgroundBrush" Color="{StaticResource AppInputBackgroundColor}"/>
    <SolidColorBrush x:Key="AppForegroundBrush" Color="{StaticResource AppForegroundColor}"/>
    <SolidColorBrush x:Key="AppMutedForegroundBrush" Color="{StaticResource AppMutedForegroundColor}"/>
    <SolidColorBrush x:Key="AppFadedForegroundBrush" Color="{StaticResource AppFadedForegroundColor}"/>
    <SolidColorBrush x:Key="AppDisabledForegroundBrush" Color="{StaticResource AppDisabledForegroundColor}"/>
    <SolidColorBrush x:Key="AppBorderBrush" Color="{StaticResource AppBorderColor}"/>
    <SolidColorBrush x:Key="AppGridLineBrush" Color="{StaticResource AppGridLineColor}"/>
    <SolidColorBrush x:Key="AppSelectionBrush" Color="{StaticResource AppSelectionColor}"/>
    <SolidColorBrush x:Key="AppSelectionInactiveBrush" Color="{StaticResource AppSelectionInactiveColor}"/>
    <SolidColorBrush x:Key="AppAccentBrush" Color="{StaticResource AppAccentColor}"/>
    <SolidColorBrush x:Key="AppAccentHoverBrush" Color="{StaticResource AppAccentHoverColor}"/>
    <SolidColorBrush x:Key="AppAccentPressedBrush" Color="{StaticResource AppAccentPressedColor}"/>
    <SolidColorBrush x:Key="AppHyperlinkBrush" Color="{StaticResource AppHyperlinkColor}"/>
    <SolidColorBrush x:Key="AppSuccessBrush" Color="{StaticResource AppSuccessColor}"/>
    <SolidColorBrush x:Key="AppWarningBrush" Color="{StaticResource AppWarningColor}"/>
    <SolidColorBrush x:Key="AppDangerBrush" Color="{StaticResource AppDangerColor}"/>
    <SolidColorBrush x:Key="AppInfoBrush" Color="{StaticResource AppInfoColor}"/>

    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="{StaticResource AppBackgroundColor}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="{StaticResource AppSurfaceAltColor}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightBrushKey}" Color="{StaticResource AppSurfaceColor}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkBrushKey}" Color="{StaticResource AppBorderColor}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="{StaticResource AppForegroundColor}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="{StaticResource AppForegroundColor}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="{StaticResource AppDisabledForegroundColor}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="{StaticResource AppSelectionColor}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="{StaticResource AppForegroundColor}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="{StaticResource AppSelectionInactiveColor}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{StaticResource AppForegroundColor}"/>
</ResourceDictionary>

