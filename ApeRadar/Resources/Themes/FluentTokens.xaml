<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">
    <FontFamily x:Key="AppFontFamily">Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI</FontFamily>

    <system:Double x:Key="AppFontSizeCaption">12</system:Double>
    <system:Double x:Key="AppFontSizeBody">14</system:Double>
    <system:Double x:Key="AppFontSizeSubtitle">16</system:Double>
    <system:Double x:Key="AppFontSizeTitle">20</system:Double>

    <system:Double x:Key="AppControlMinHeight">32</system:Double>
    <system:Double x:Key="AppTouchTargetMinHeight">40</system:Double>

    <CornerRadius x:Key="AppControlCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="AppSurfaceCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="AppOverlayCornerRadius">8</CornerRadius>

    <Thickness x:Key="AppControlPadding">10,5</Thickness>
    <Thickness x:Key="AppCompactControlPadding">8,3</Thickness>
    <Thickness x:Key="AppFocusBorderThickness">2</Thickness>
    <Thickness x:Key="AppSectionSpacing">16</Thickness>
</ResourceDictionary>
